# ═══════════════════════════════════════════════════════════════════
# PrintShop SaaS — Environment Variables (copy to .env + fill in)
# ═══════════════════════════════════════════════════════════════════
# Generate secrets with:
#   openssl rand -hex 32          (for JWT secrets)
#   openssl rand 32 | base64      (for encryption key)

# ─── Database (Supabase PostgreSQL) ────────────────────────────────
# Find this in: Supabase Dashboard → Connect → Direct → Connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# ─── Supabase Storage (file uploads) ───────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the SECRET key (sb_secret_...), NOT the publishable key (sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=printshop-uploads

# ─── JWT Authentication ────────────────────────────────────────────
JWT_ACCESS_SECRET=generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=generate_a_different_openssl_rand_hex_32

# ─── Payment Credential Encryption ─────────────────────────────────
# AES-256-GCM key (32 bytes base64). Generate: openssl rand 32 | base64
PAYMENT_ENCRYPTION_KEY=generate_with_openssl_rand_32_base64

# ─── PhonePe Webhook Authentication ────────────────────────────────
# Configure these in the PhonePe merchant dashboard (Webhook → SHA auth)
PHONEPE_WEBHOOK_USERNAME=your_username
PHONEPE_WEBHOOK_PASSWORD=your_password

# ─── Internal ──────────────────────────────────────────────────────
# Socket.io emit secret (internal — for realtime auth)
REALTIME_EMIT_SECRET=generate_with_openssl_rand_hex_32

# ─── App URL ───────────────────────────────────────────────────────
# The deployed URL (used for QR codes, payment callbacks, redirects)
APP_BASE_URL=https://printshop-saas-three.vercel.app

# ─── Optional: Upstash Redis (for production rate limiting) ────────
# Without Redis, rate limiting is per-invocation (Vercel serverless)
# CACHE_PROVIDER=redis
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token
