# ═══════════════════════════════════════════════════════════════════
# PrintShop SaaS — Environment Variables (copy to .env + fill in)
# ═══════════════════════════════════════════════════════════════════
# Generate secrets with:
#   openssl rand -hex 32          (for JWT secrets)
#   openssl rand 32 | base64      (for encryption key)

# ─── Database (Supabase PostgreSQL) ────────────────────────────────
# Find this in: Supabase Dashboard → Connect → Direct → Connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# ─── Supabase Storage (file uploads) ───────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the SECRET key (sb_secret_...), NOT the publishable key (sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=printshop-uploads

# ─── JWT Authentication ────────────────────────────────────────────
JWT_ACCESS_SECRET=generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=generate_a_different_openssl_rand_hex_32

# ─── Device Token Pepper (Phase C) ─────────────────────────────────
# HMAC pepper for device-credential verifiers. REQUIRED in production
# (startup fails without it); dev/test falls back to the legacy pepper so
# existing local databases keep working. Generate: openssl rand -hex 32
# Existing (legacy-format) device hashes keep verifying until each device
# rotates its token via POST /api/v1/companion/token/rotate.
DEVICE_TOKEN_PEPPER=generate_with_openssl_rand_hex_32

# ─── Payment Credential Encryption ─────────────────────────────────
# AES-256-GCM key (32 bytes base64). Generate: openssl rand 32 | base64
PAYMENT_ENCRYPTION_KEY=generate_with_openssl_rand_32_base64

# ─── PhonePe Webhook Authentication ────────────────────────────────
# Configure these in the PhonePe merchant dashboard (Webhook → SHA auth)
PHONEPE_WEBHOOK_USERNAME=your_username
PHONEPE_WEBHOOK_PASSWORD=your_password

# ─── Internal ──────────────────────────────────────────────────────
# Socket.io emit secret (internal — for realtime auth)
REALTIME_EMIT_SECRET=generate_with_openssl_rand_hex_32

# ─── App URL ───────────────────────────────────────────────────────
# The deployed URL (used for QR codes, payment callbacks, redirects)
APP_BASE_URL=https://printshop-saas-three.vercel.app

# ─── Optional: Upstash Redis (for production rate limiting) ────────
# Without Redis, rate limiting is per-invocation (Vercel serverless)
# CACHE_PROVIDER=redis
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token

# ─── Cron Cleanup Secret ───────────────────────────────────────────
# Secret for the Vercel Cron cleanup endpoint (/api/v1/cron/cleanup)
# Vercel Cron automatically sends Authorization: Bearer <CRON_SECRET>
# Generate: openssl rand -hex 32
CRON_SECRET=generate_with_openssl_rand_hex_32

# ─── Phone OTP (P8.6 — OFF by default) ─────────────────────────────
# OTP protects the /orders "Look up by phone" cross-device flow ONLY.
# The default order path stays on the 128-bit order token + device-local
# recent-orders list. Flip to "true" to enable the OTP send/verify endpoints
# + the /orders phone-lookup panel.
# OTP_ENABLED=true
# NEXT_PUBLIC_OTP_ENABLED=true   # must mirror OTP_ENABLED (client build flag)
# OTP_PROVIDER=console           # console (dev logs the code) | sms (stub)
# ── SMS gateway (only when OTP_PROVIDER=sms) ──
# Real SMS in India needs DLT registration (TRAI) + costs ~₹0.20-0.40/msg.
# The sms-otp-provider.ts is a STUB — wire MSG91/Twilio/Gupshup there before
# enabling OTP in production. See src/lib/auth/sms-otp-provider.ts for the
# integration checklist.
# SMS_GATEWAY=msg91
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_DLT_TEMPLATE_ID=

# ─── Optional: platform / runtime switches ─────────────────────────
# These are read by src/lib/container.ts and adapters. Defaults are fine
# for local dev; production (Vercel) pins some of them in vercel.json.
# DATABASE_PROVIDER=prisma        # prisma | memory
# STORAGE_PROVIDER=supabase       # supabase | s3 | r2 | local | memory | disabled
# STORAGE_LOCAL_DIR=./storage-data # root dir for STORAGE_PROVIDER=local (server disk)
# STORAGE_CAPABILITY_SECRET=      # HMAC secret for dev in-memory signed URLs
# REALTIME_PROVIDER=memory        # memory | relay (relay = POST to /emit)
# REALTIME_EMIT_URL=http://127.0.0.1:3004/emit  # realtime mini-service relay
# CORS_ALLOWED_ORIGINS=           # comma-separated origins for the realtime service
# TRUSTED_PROXY=                  # set when a trusted proxy provides X-Forwarded-For
# CACHE_PROVIDER=memory           # memory | redis (see Upstash section)

# ─── Optional: bootstrap admin login (/admin/login) ────────────────
# If set, ADMIN login is accepted via constant-time compare against the
# environment values. Leave unset to disable the env admin path.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=generate_with_openssl_rand_32_base64


# ── Real-PostgreSQL integration tests (vitest) ──
# The pg-backed tests default to a local trust-auth cluster with these DBs:
#   phb_p3 / phb_p4 (webhook concurrency) — apply prisma migrations first:
#   DATABASE_URL=postgresql://z@127.0.0.1:5433/phb_p3 ./node_modules/.bin/prisma migrate deploy
TEST_DATABASE_URL=postgresql://z@127.0.0.1:5433/phb_p3

# ─── Clerk authentication (Google sign-in) ─────────────────────────
# Create the application in the Clerk dashboard (https://dashboard.clerk.com)
# with Arjun's account (arjunyadav35763@gmail.com), enable Google OAuth,
# then paste the keys into Vercel. Until BOTH keys are set, Clerk stays
# off and the JWT email+password login is the only sign-in — nothing
# breaks. CLERK_WEBHOOK_SECRET comes from Clerk dashboard → Webhooks
# (endpoint: https://printelyx.cc.cd/api/webhooks/clerk).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY
# CLERK_SECRET_KEY=sk_test_YOUR_KEY
# CLERK_WEBHOOK_SECRET=whsec_YOUR_SECRET

# ─── Resend email API ──────────────────────────────────────────────
# Create the account + API key in the Resend dashboard
# (https://resend.com) with Arjun's email, verify the printelyx.cc.cd
# domain there (DNS TXT records), then set these in Vercel. Until
# EMAIL_PROVIDER=resend + RESEND_API_KEY are set, email stays on the
# in-memory stub (password-reset links are captured, not delivered).
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_YOUR_KEY
# EMAIL_FROM=no-reply@printelyx.cc.cd

# ─── ToroPay (UPI payment-link platform) ───────────────────────────
# ToroPay dashboard: https://www.toropay.co.in/dashboard
# ToroPay docs: https://www.toropay.co.in/docs
# Developer dashboard (API keys + webhook secret): https://www.toropay.co.in/dashboard/developers
# Webhook URL to register: https://<your-domain>/api/v1/payments/toropay/webhook
# Webhook secret: generate in the ToroPay developer dashboard; used to verify
# HMAC SHA-256 signatures on X-ToroPay-Signature headers.
# Mode: "test" for sandbox, "live" for production. Do NOT enable live until
# the full checkout flow is verified in test mode.
# ToroPay API base is hardcoded in the adapter: https://www.toropay.co.in/api/v1
# TOROPAY_API_KEY=your_api_key
# TOROPAY_WEBHOOK_SECRET=your_webhook_signing_secret
# TOROPAY_MODE=test
# TOROPAY_RETURN_URL=https://your-domain/o/{token}

# ─── Google OAuth + Gmail API (payment reconciliation) ────────────
# Google Cloud Console: https://console.cloud.google.com/
# 1. Create a project (or use existing)
# 2. Enable Gmail API: APIs & Services → Library → Gmail API → Enable
# 3. OAuth consent screen: APIs & Services → OAuth consent screen
#    - User type: External (or Internal for Workspace)
#    - Scopes: gmail.readonly (https://www.googleapis.com/auth/gmail.readonly)
#    - Add test users (the shopkeeper's Gmail address)
# 4. Create OAuth client: APIs & Services → Credentials → Create → OAuth client ID
#    - Application type: Web application
#    - Authorized redirect URI: https://printelyx.cc.cd/api/v1/shops/me/gmail/callback
# 5. Copy the Client ID + Client Secret
# Google verification: required for production if more than 100 users.
# Until verified, only test users can grant access.
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REDIRECT_URI=https://printelyx.cc.cd/api/v1/shops/me/gmail/callback
