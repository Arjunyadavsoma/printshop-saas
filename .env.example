# PrintShop SaaS — Environment Variables
#
# Copy this file to .env (or .env.local) and fill in the real values.
# NEVER commit .env or .env.local — they are gitignored.
#
# For Vercel deployment, set these in the Vercel dashboard (Project → Settings → Environment Variables).

# ── Database (REQUIRED for production) ──
# Neon PostgreSQL connection string (from `neon connection-string` or Neon console).
# Use the POOLED connection string for the app, and the DIRECT connection for migrations.
# Format: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Database provider (always "prisma" in production)
DATABASE_PROVIDER=prisma

# ── Storage (REQUIRED for production) ──
# Option 1: Supabase Storage (free 1GB, no credit card needed)
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_STORAGE_BUCKET=printshop-uploads
#
# Option 2: S3-compatible (Neon Object Storage, AWS S3, MinIO, etc.)
# STORAGE_PROVIDER=s3
# AWS_ENDPOINT_URL_S3=https://<branch>.storage.<region>.aws.neon.tech
# AWS_ACCESS_KEY_ID=<your-access-key>
# AWS_SECRET_ACCESS_KEY=<your-secret-key>
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=<your-bucket-name>
#
# Option 2: Cloudflare R2
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=<your-account-id>
# R2_ACCESS_KEY_ID=<your-access-key>
# R2_SECRET_ACCESS_KEY=<your-secret-key>
# R2_BUCKET=<your-bucket-name>

# ── Cache (REQUIRED for production) ──
# Upstash Redis (REST URL + token).
# CACHE_PROVIDER=redis
# REDIS_URL=https://xxx.upstash.io
# REDIS_TOKEN=<your-token>

# ── Authentication secrets (REQUIRED for production) ──
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=<generate-with-openssl-rand-hex-32>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-32>

# ── Storage HMAC secret (for presigned upload/download URLs) ──
# Generate with: openssl rand -hex 32
STORAGE_CAPABILITY_SECRET=<generate-with-openssl-rand-hex-32>

# ── Payment credential encryption key (AES-256-GCM) ──
# Generate with: openssl rand 32 | base64
PAYMENT_ENCRYPTION_KEY=<generate-with-openssl-rand-32-base64>

# ── Realtime (OPTIONAL — can be "memory" for no live updates) ──
# REALTIME_PROVIDER=memory
# REALTIME_EMIT_URL=http://127.0.0.1:3004/emit
# REALTIME_EMIT_SECRET=<generate-with-openssl-rand-hex-32>

# ── Application config ──
# APP_BASE_URL=https://your-deployment-url.vercel.app
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# TRUSTED_PROXY=1
# NEXT_PUBLIC_API_BASE=/api/v1

# ── Payment provider (OPTIONAL — simulated payment works without these) ──
# PHONEPE_SALT_KEY=<sandbox-salt-key>
# PHONEPE_SALT_INDEX=1
# PHONEPE_MERCHANT_ID=<sandbox-merchant-id>
# PAYTM_MERCHANT_ID=<sandbox-merchant-id>
# PAYTM_MERCHANT_KEY=<sandbox-merchant-key>

# ── Local development (SQLite — NOT for production) ──
# DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Admin credentials (OPTIONAL — enables env-var-based admin login) ──
# Set these on Vercel to enable admin login without seeding the DB.
# The admin password is NEVER stored in the database — it's verified
# in-memory against this env var using a constant-time comparison.
ADMIN_EMAIL=<your-admin-email>
ADMIN_PASSWORD=<your-strong-admin-password>

# Admin access key — required in the URL to access the admin login page.
# Example: /admin/login?k=printshop-admin-2024
ADMIN_ACCESS_KEY=<your-access-key>
