# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Local databases (NEVER commit — may contain customer data)
*.db
*.db-journal
*.db-wal
*.db-shm
/db/
/prisma/db/

# Disposable staging artifacts (regenerable via scripts/ — see docs/STAGING_TESTS.md)
/tmp/

# Tool output dumps
/tool-results/

# Test fixtures generated on demand (run scripts/make-test-pdf.ts)
*.pdf

# Screenshots from browser verification
*.png
# Required public assets referenced by the app — never ignore these:
# og.png (OpenGraph/Twitter previews, referenced in layout metadata)
# download-qr.png (/download-app static QR)
!public/og.png
!public/download-qr.png

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
# exception: the local-disk storage adapter (source code, not local config)
!packages/adapters/src/storage/local-disk.adapter.ts
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# Top-level stray test artifacts (NOT the a11y test helper under src/lib/test).
# Anchored to repo root so src/lib/test/axe-check.ts and its siblings stay tracked.
/test
prompt

server.log
# Skills directory
/skills/
# PID files (runtime artifacts — should never be committed)
*.pid
.neon

# Playwright test artifacts (keep .last-run.json, ignore screenshots/videos)
test-results/*/
playwright-report/
