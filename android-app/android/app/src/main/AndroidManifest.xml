<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep-link handler: printshop://shop/{slug}
                 Scanning the shop's "Sticker PDF" QR code (which encodes the
                 shop's customer URL) can open the companion app directly
                 instead of the browser. The QR encodes an HTTPS URL; Android
                 App Links (below) handle HTTPS. This custom-scheme handler
                 is for the printshop:// scheme used by in-app deep-links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="printshop" android:host="shop" />
            </intent-filter>

            <!-- App Link: HTTPS URLs for the deployed web app open in the
                 companion app instead of the browser. This requires the
                 deployed web app to serve an assetlinks.json file at
                 /.well-known/assetlinks.json (Phase 2 — for now, the intent
                 filter is declared but the assetlinks.json isn't hosted, so
                 Android falls back to the browser). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="printshop-saas.vercel.app" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions: internet for WebView + API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera: for the native document-scan bridge -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Storage: for picking existing files (images/PDFs) from the gallery -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13+ uses granular media permissions instead of READ_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Notifications: for the "prints ready" local notification bridge -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibrate: for notification haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Camera hardware feature (not required — app works without camera,
         but the document-scan bridge needs it for photo capture) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

</manifest>
