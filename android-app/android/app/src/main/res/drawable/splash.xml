<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen drawable — brand background with the real logo centered.
    Referenced by AppTheme.NoActionBarLaunch in styles.xml as @drawable/splash.
    The theme is the launch theme (shown before the WebView loads), so the
    user sees the branded splash for launchShowDuration instead of a white
    or black flash.

    Layer-list (not a vector): the background is the brand ground colour
    (#F4F6F8, same as the consumer redesign) and the logo is the actual
    P monogram rendered from public/logo.svg into drawable-nodpi/ so it
    scales crisply on every density.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:drawable="@drawable/splash_logo"
        android:gravity="center" />
</layer-list>
