<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon (round variant for Android 8.0+ / API 26+).
    Foreground = the brand "P" monogram PNG in mipmap-*/ic_launcher_foreground.png
    (generated from public/logo.svg — the same logo the web navbar uses).
    Monochrome reuses the same alpha mask so themed icons (Android 13+)
    show the P silhouette tinted by the launcher.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
