{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/s/quickprint",
        "http://localhost:3000/s/quickprint#options",
        "http://localhost:3000/s/quickprint#pay",
        "http://localhost:3000/o/test-token",
        "http://localhost:3000/orders",
        "http://localhost:3000/help",
        "http://localhost:3000/privacy"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "mobile",
        "throttling": {
          "cpuSlowdownMultiplier": 4,
          "downloadThroughputKbps": 1500,
          "uploadThroughputKbps": 750,
          "rttMs": 150
        },
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "unused-javascript": ["warn", { "maxNumericValue": 170000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "docs/redesign/evidence/lighthouse"
    }
  }
}
