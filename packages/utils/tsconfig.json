{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["es2021"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@platform/core": ["../core/src/index.ts"],
      "@platform/core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
