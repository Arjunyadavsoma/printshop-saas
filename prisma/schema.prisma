generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id                    String        @id @default(uuid())
  name                  String
  slug                  String        @unique
  ownerUserId           String
  upiId                 String
  paymentProvider       String
  paymentCredentials    String
  pricingConfig         String
  address               String
  phone                 String
  timezone              String        @default("Asia/Kolkata")
  isActive              Boolean       @default(true)
  subscriptionTier      String        @default("free")
  subscriptionExpiresAt DateTime?
  description           String?
  businessHours         String?
  logoUrl               String?
  upiQrStorageKey       String?
  servicesJson          String?
  paymentPhone          String?
  paymentInstructions   String?
  cashOnPickup          Boolean       @default(false)
  // ── Payment method customization ──
  // 'upi' = UPI only, 'cash' = cash only, 'both' = UPI + cash,
  // 'split' = split payment (partial UPI + partial cash)
  paymentMethods        String        @default("both")
  // ── Pamphlet / cover sheet feature ──
  // Shopkeeper can offer a pamphlet (folder/cover) where printed pages are
  // kept. Customer can add it during checkout (extra charge). Useful when
  // customer prints from home + picks up later.
  pamphletEnabled       Boolean       @default(false)
  pamphletPricePaise    Int           @default(0)
  pamphletName          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  auditLogs             AuditLog[]
  orders                Order[]
  agents                PrintAgent[]
  printJobs             PrintJob[]
  subscription          Subscription?
  users                 User[]
  paymentAttempts       PaymentAttempt[]

  @@index([slug])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String
  passwordHash String
  role         String     @default("owner")
  shopId       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  shop         Shop?      @relation(fields: [shopId], references: [id])

  @@index([shopId])
}

model Order {
  id               String      @id @default(uuid())
  shopId           String
  customerToken    String
  status           String      @default("awaiting_payment")
  totalAmountPaise Int
  currency         String      @default("INR")
  paymentProvider  String?
  paymentTxnId     String?     @unique
  paymentUtr       String?
  paidAt           DateTime?
  customerPhone    String?
  notes            String?
  tokenNumber      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  shop             Shop        @relation(fields: [shopId], references: [id])
  files            PrintFile[]
  paymentAttempts  PaymentAttempt[]

  @@unique([shopId, tokenNumber])
  @@index([shopId, status])
  @@index([customerToken])
}

model PrintFile {
  id               String     @id @default(uuid())
  orderId          String
  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  pageCount        Int?
  copies           Int        @default(1)
  colorMode        String     @default("bw")
  pageRange        String?
  paperSize        String     @default("a4")
  duplex           Boolean    @default(false)
  pricePaise       Int        @default(0)
  status           String     @default("pending")
  printedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  order            Order      @relation(fields: [orderId], references: [id])
  printJobs        PrintJob[]

  @@index([orderId])
}

model PrintJob {
  id          String    @id @default(uuid())
  shopId      String
  fileId      String
  agentId     String?
  status      String    @default("queued")
  attempts    Int       @default(0)
  lastError   String?
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  file        PrintFile @relation(fields: [fileId], references: [id])
  shop        Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, status])
  @@index([agentId])
}

model PrintAgent {
  id          String    @id @default(uuid())
  shopId      String
  name        String
  tokenHash   String
  lastSeenAt  DateTime?
  printerName String?
  isOnline    Boolean   @default(false)
  version     String?
  os          String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shop        Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, isOnline])
}

model Subscription {
  id                     String   @id @default(uuid())
  shopId                 String   @unique
  tier                   String   @default("free")
  status                 String   @default("active")
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  provider               String   @default("internal")
  providerSubscriptionId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  shop                   Shop     @relation(fields: [shopId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  shopId     String?
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   String
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  shop       Shop?    @relation(fields: [shopId], references: [id])

  @@index([shopId, createdAt])
}

// ─── Payment persistence (Phase 4 — durable webhook mapping) ───────
// Previously the merchantOrderId→orderId mapping lived ONLY in a 10-min
// cache session. Slow PSPs (>10min) or Vercel cold starts (per-invocation
// memory) made delayed webhooks impossible to resolve. These models move
// the mapping into durable DB records.

model PaymentAttempt {
  id                   String    @id @default(uuid())
  shopId               String
  orderId              String
  provider             String   // 'phonepe' | 'paytm' | 'googlepay' (UPI deep-link)
  merchantOrderId      String   @unique // our per-attempt UUID; the PSP references this
  providerTransactionId String? // PSP's transaction id (set on webhook/status)
  amountPaise          Int
  currency             String   @default("INR")
  status              String   @default("created") // created|pending|paid|failed|expired
  idempotencyKey       String?  // optional PSP idempotency token
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  shop                 Shop     @relation(fields: [shopId], references: [id])
  order                Order    @relation(fields: [orderId], references: [id])
  events               PaymentEvent[]

  @@index([shopId, status])
  @@index([orderId])
  @@index([providerTransactionId])
}

model PaymentEvent {
  id                   String    @id @default(uuid())
  attemptId            String
  provider             String
  eventId              String?   // PSP's event id (for dedup)
  merchantOrderId      String?
  providerTransactionId String?
  eventType            String    // webhook|status_check|reconciliation
  signatureValid       Boolean   @default(false)
  processingStatus     String    @default("received") // received|processed|skipped|failed
  receivedAt           DateTime  @default(now())
  processedAt          DateTime?
  errorMessage         String?
  attempt              PaymentAttempt @relation(fields: [attemptId], references: [id])

  @@unique([provider, eventId])
  @@index([attemptId])
  @@index([merchantOrderId])
}
