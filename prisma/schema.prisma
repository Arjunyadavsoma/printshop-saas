generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shop {
  id                    String        @id @default(uuid())
  name                  String
  slug                  String        @unique
  ownerUserId           String
  upiId                 String
  paymentProvider       String
  paymentCredentials    String
  pricingConfig         String
  address               String
  phone                 String
  timezone              String        @default("Asia/Kolkata")
  isActive              Boolean       @default(true)
  subscriptionTier      String        @default("free")
  subscriptionExpiresAt DateTime?
  description           String?
  businessHours         String?
  logoUrl               String?
  upiQrStorageKey       String?
  servicesJson          String?
  paymentPhone          String?
  paymentInstructions   String?
  cashOnPickup          Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  auditLogs             AuditLog[]
  orders                Order[]
  agents                PrintAgent[]
  printJobs             PrintJob[]
  subscription          Subscription?
  users                 User[]

  @@index([slug])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String
  passwordHash String
  role         String     @default("owner")
  shopId       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  shop         Shop?      @relation(fields: [shopId], references: [id])

  @@index([shopId])
}

model Order {
  id               String      @id @default(uuid())
  shopId           String
  customerToken    String
  status           String      @default("awaiting_payment")
  totalAmountPaise Int
  currency         String      @default("INR")
  paymentProvider  String?
  paymentTxnId     String?     @unique
  paymentUtr       String?
  paidAt           DateTime?
  customerPhone    String?
  notes            String?
  tokenNumber      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  shop             Shop        @relation(fields: [shopId], references: [id])
  files            PrintFile[]

  @@unique([shopId, tokenNumber])
  @@index([shopId, status])
  @@index([customerToken])
}

model PrintFile {
  id               String     @id @default(uuid())
  orderId          String
  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  pageCount        Int?
  copies           Int        @default(1)
  colorMode        String     @default("bw")
  pageRange        String?
  paperSize        String     @default("a4")
  duplex           Boolean    @default(false)
  pricePaise       Int        @default(0)
  status           String     @default("pending")
  printedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  order            Order      @relation(fields: [orderId], references: [id])
  printJobs        PrintJob[]

  @@index([orderId])
}

model PrintJob {
  id          String    @id @default(uuid())
  shopId      String
  fileId      String
  agentId     String?
  status      String    @default("queued")
  attempts    Int       @default(0)
  lastError   String?
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  file        PrintFile @relation(fields: [fileId], references: [id])
  shop        Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, status])
  @@index([agentId])
}

model PrintAgent {
  id          String    @id @default(uuid())
  shopId      String
  name        String
  tokenHash   String
  lastSeenAt  DateTime?
  printerName String?
  isOnline    Boolean   @default(false)
  version     String?
  os          String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shop        Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, isOnline])
}

model Subscription {
  id                     String   @id @default(uuid())
  shopId                 String   @unique
  tier                   String   @default("free")
  status                 String   @default("active")
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  provider               String   @default("internal")
  providerSubscriptionId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  shop                   Shop     @relation(fields: [shopId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  shopId     String?
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   String
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  shop       Shop?    @relation(fields: [shopId], references: [id])

  @@index([shopId, createdAt])
}
