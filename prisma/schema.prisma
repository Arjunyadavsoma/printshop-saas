generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id                    String           @id @default(uuid())
  name                  String
  slug                  String           @unique
  ownerUserId           String
  upiId                 String
  paymentProvider       String
  paymentCredentials    String
  pricingConfig         String
  address               String
  phone                 String
  timezone              String           @default("Asia/Kolkata")
  isActive              Boolean          @default(true)
  subscriptionTier      String           @default("free")
  subscriptionExpiresAt DateTime?
  description           String?
  businessHours         String?
  logoUrl               String?
  upiQrStorageKey       String?
  servicesJson          String?
  paymentPhone          String?
  paymentInstructions   String?
  cashOnPickup          Boolean          @default(false)
  // ── Payment method customization ──
  // 'upi' = UPI only, 'cash' = cash only, 'both' = UPI + cash,
  // 'split' = split payment (partial UPI + partial cash)
  paymentMethods        String           @default("both")
  // ── Pamphlet / cover sheet feature ──
  // Shopkeeper can offer a pamphlet (folder/cover) where printed pages are
  // kept. Customer can add it during checkout (extra charge). Useful when
  // customer prints from home + picks up later.
  pamphletEnabled       Boolean          @default(false)
  pamphletPricePaise    Int              @default(0)
  pamphletName          String?
  // NOTE: revision + deletedAt removed from existing models to avoid
  // breaking production (DB migration not yet run). See docs/MIGRATION_PLAN.md.
  // These will be re-added when `bun run db:push` is executed.
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  auditLogs             AuditLog[]
  orders                Order[]
  agents                PrintAgent[]
  printJobs             PrintJob[]
  subscription          Subscription?
  users                 User[]
  paymentAttempts       PaymentAttempt[]

  @@index([slug])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String
  passwordHash String
  role         String     @default("owner")
  shopId       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  shop         Shop?      @relation(fields: [shopId], references: [id])

  @@index([shopId])
}

model Order {
  id               String           @id @default(uuid())
  shopId           String
  customerToken    String
  status           String           @default("awaiting_payment")
  totalAmountPaise Int
  currency         String           @default("INR")
  paymentProvider  String?
  paymentTxnId     String?          @unique
  paymentUtr       String?
  paidAt           DateTime?
  customerPhone    String?
  notes            String?
  tokenNumber      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  shop             Shop             @relation(fields: [shopId], references: [id])
  files            PrintFile[]
  paymentAttempts  PaymentAttempt[]

  @@unique([shopId, tokenNumber])
  @@index([shopId, status])
  @@index([customerToken])
}

model PrintFile {
  id               String     @id @default(uuid())
  orderId          String
  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  pageCount        Int?
  pageCountSource  String     @default("placeholder")
  copies           Int        @default(1)
  colorMode        String     @default("bw")
  pageRange        String?
  paperSize        String     @default("a4")
  duplex           Boolean    @default(false)
  pricePaise       Int        @default(0)
  status           String     @default("pending")
  processingError  String?
  printedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  order            Order      @relation(fields: [orderId], references: [id])
  printJobs        PrintJob[]

  @@index([orderId])
}

model PrintJob {
  id          String    @id @default(uuid())
  shopId      String
  fileId      String
  agentId     String?
  status      String    @default("queued")
  attempts    Int       @default(0)
  lastError   String?
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  file        PrintFile @relation(fields: [fileId], references: [id])
  shop        Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, status])
  @@index([agentId])
}

model PrintAgent {
  id          String    @id @default(uuid())
  shopId      String
  name        String
  tokenHash   String
  lastSeenAt  DateTime?
  printerName String?
  isOnline    Boolean   @default(false)
  version     String?
  os          String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shop        Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, isOnline])
}

model Subscription {
  id                     String   @id @default(uuid())
  shopId                 String   @unique
  tier                   String   @default("free")
  status                 String   @default("active")
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  provider               String   @default("internal")
  providerSubscriptionId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  shop                   Shop     @relation(fields: [shopId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  shopId     String?
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   String
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  shop       Shop?    @relation(fields: [shopId], references: [id])

  @@index([shopId, createdAt])
}

// ─── Payment persistence (Phase 4 — durable webhook mapping) ───────
// Previously the merchantOrderId→orderId mapping lived ONLY in a 10-min
// cache session. Slow PSPs (>10min) or Vercel cold starts (per-invocation
// memory) made delayed webhooks impossible to resolve. These models move
// the mapping into durable DB records.

model PaymentAttempt {
  id                    String         @id @default(uuid())
  shopId                String
  orderId               String
  provider              String // 'phonepe' | 'paytm' | 'googlepay' (UPI deep-link)
  merchantOrderId       String         @unique // our per-attempt UUID; the PSP references this
  providerTransactionId String? // PSP's transaction id (set on webhook/status)
  amountPaise           Int
  currency              String         @default("INR")
  status                String         @default("created") // created|pending|paid|failed|expired
  idempotencyKey        String? // optional PSP idempotency token
  expiresAt             DateTime
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  shop                  Shop           @relation(fields: [shopId], references: [id])
  order                 Order          @relation(fields: [orderId], references: [id])
  events                PaymentEvent[]

  @@index([shopId, status])
  @@index([orderId])
  @@index([orderId, status])
  @@index([providerTransactionId])

  // Phase 6.4: Partial unique index — at most one 'created' attempt per order.
  // Prisma 6.x does NOT natively support partial unique indexes in the schema
  // declaration (@@unique creates a full UNIQUE constraint, not partial). The
  // authoritative DDL lives in
  // `prisma/migrations/20251110000000_add_active_attempt_unique_index/migration.sql`
  // and is applied by `prisma migrate deploy` / `pg-migrate-prod.sh`.
  // The comment here is documentation only — `prisma validate` does not
  // verify partial indexes (they are PostgreSQL-specific extensions beyond
  // Prisma's declarative schema grammar).
}

model PaymentEvent {
  id                    String         @id @default(uuid())
  attemptId             String
  provider              String
  eventId               String? // PSP's event id (for dedup)
  merchantOrderId       String?
  providerTransactionId String?
  eventType             String // webhook|status_check|reconciliation
  signatureValid        Boolean        @default(false)
  processingStatus      String         @default("received") // received|processed|skipped|failed
  receivedAt            DateTime       @default(now())
  processedAt           DateTime?
  errorMessage          String?
  attempt               PaymentAttempt @relation(fields: [attemptId], references: [id])

  @@unique([provider, eventId])
  @@index([attemptId])
  @@index([merchantOrderId])
}

// ─── Webhook Inbox (Phase 6.12) ──────────────────────────────────────
// Durable storage for verified webhook callbacks that arrive before the
// corresponding PaymentAttempt exists (race condition: callback beats
// checkout persistence). The recovery worker (invoked by the reconciliation
// cron) matches inbox entries to PaymentAttempts and processes them.
//
// Only VERIFIED callbacks (signature passed) are persisted here.
// Unverified callbacks are rejected with 401 and NOT persisted.
//
// No secrets, authorization headers, or raw payload bytes are stored.

model WebhookInbox {
  id                   String    @id @default(uuid())
  provider             String   // phonepe | paytm | googlepay
  merchantOrderId      String   // the reference extracted from the payload
  providerEventId      String?  // PSP's event ID (for dedup, if available)
  providerTxnId        String?  // PSP's transaction ID
  amountPaise          Int?     // amount from the verified payload
  currency             String   @default("INR")
  signatureValid       Boolean  @default(true) // always true — only verified events are stored
  processingStatus     String   @default("unmatched") // unmatched|matched|processed|exhausted
  receivedAt           DateTime @default(now())
  processedAt          DateTime?
  retryCount           Int      @default(0)
  nextRetryAt          DateTime?
  errorMessage         String?

  @@unique([provider, providerEventId])
  @@index([merchantOrderId])
  @@index([processingStatus, nextRetryAt])
}

// ─── Sync infrastructure (Phase 5) ───────────────────────────────────
// Bidirectional sync state for the PrintEXE Windows desktop client.
// See docs/SYNC_PROTOCOL.md for the full design.

model DeviceSyncState {
  id         String    @id @default(uuid())
  shopId     String // tenant FK
  deviceId   String // the PrintAgent ID acting as a sync device
  syncCursor String    @default("1970-01-01T00:00:00Z") // ISO timestamp cursor
  lastSyncAt DateTime?
  lastPushAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([shopId, deviceId])
  @@index([shopId])
}

model Customer {
  id        String    @id @default(uuid())
  shopId    String // tenant FK
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  // Sync fields
  revision  Int       @default(1)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

// ─── Delivery infrastructure (Phase 5-7) ─────────────────────────────
// Tracks each attempt to deliver a print job to a PrintEXE device.
// Separate from PrintJob.status (printing state) — this tracks the
// DOCUMENT DELIVERY state (was the file received by the device?).
// See docs/DOCUMENT_DELIVERY_ARCHITECTURE.md

model PrintDeliveryAttempt {
  id           String    @id @default(uuid())
  printJobId   String // FK → PrintJob (logical — no Prisma relation to avoid migration)
  agentId      String // FK → PrintAgent (the targeted device)
  shopId       String // tenant FK
  attemptId    Int       @default(1) // per-job sequence (1st attempt, 2nd, etc.)
  deliveryMode String    @default("cloud") // cloud|direct|webrtc
  status       String    @default("created") // created|dispatched|received|failed|expired
  checksum     String? // SHA-256 hex of the delivered file
  fileSize     Int? // bytes
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shopId, status])
  @@index([agentId])
  @@index([printJobId])
}

// Scheduled cloud file cleanup tasks.
// Created after a delivery receipt is confirmed — the file is deleted
// from cloud storage after a grace period (default 15 min).
// See docs/FILE_RETENTION_POLICY.md

model FileCleanupTask {
  id          String    @id @default(uuid())
  printFileId String // FK → PrintFile (logical)
  shopId      String // tenant FK
  storageKey  String // the S3/R2/Supabase object key
  cleanupType String    @default("after_receipt") // after_receipt|after_collect|forced
  scheduledAt DateTime // when to attempt deletion
  completedAt DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  status      String    @default("pending") // pending|completed|failed|skipped
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([shopId, status])
  @@index([scheduledAt])
  @@index([printFileId])
}
