// PrintShop SaaS — Prisma schema mirroring §4 of the spec.
//
// NOTE on portability: the spec mandates Drizzle ORM with adapter-swappable
// Postgres providers. The sandbox here ships Prisma pre-installed, so this
// schema is the Prisma expression of the identical domain model defined in
// packages/core. When we move to the real monorepo (Phase 2), the same model
// is expressed in Drizzle against the same Postgres DDL — the core package
// stays untouched because business logic only ever imports adapter interfaces.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// All money is integer paise (1 INR = 100 paise). NEVER float.

model Shop {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  ownerUserId   String
  upiId         String
  paymentProvider       String
  // JSONB-equivalent: encrypted at rest with libsodium sealed boxes.
  paymentCredentials    String
  pricingConfig         String // JSON-serialised ShopPricingConfig
  address               String
  phone                 String
  timezone              String   @default("Asia/Kolkata")
  isActive              Boolean  @default(true)
  subscriptionTier      String   @default("free")
  subscriptionExpiresAt DateTime?
  // New: shopkeeper-facing profile fields (all nullable — additive schema change).
  description           String?
  businessHours         String? // JSON-serialised { mon: {open,close}, ... }
  logoUrl               String?
  upiQrStorageKey       String? // storage key for the UPI QR image (private object)
  servicesJson          String? // JSON list of selected print services (bw,color,scan,laminate,binding)
  paymentPhone          String? // separate from business phone — used for UPI verification
  paymentInstructions   String? // shown to customer at checkout
  cashOnPickup          Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users         User[]
  orders        Order[]
  agents        PrintAgent[]
  printJobs     PrintJob[]
  auditLogs     AuditLog[]
  subscription  Subscription?

  @@index([slug])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String
  passwordHash String
  role         String    @default("owner")
  shopId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  shop        Shop?     @relation(fields: [shopId], references: [id])
  auditLogs   AuditLog[]

  @@index([shopId])
}

model Order {
  id                String    @id @default(uuid())
  shopId            String
  customerToken     String
  status            String    @default("awaiting_payment")
  totalAmountPaise  Int
  currency          String    @default("INR")
  paymentProvider   String?
  // UNIQUE constraint prevents webhook replay attacks.
  paymentTxnId      String?  @unique
  paymentUtr        String?
  paidAt            DateTime?
  customerPhone     String?
  notes             String?
  // New: human-friendly per-shop sequential token (e.g. "A104", "B205").
  // Generated when the order is created; unique within the shop.
  tokenNumber       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop        Shop        @relation(fields: [shopId], references: [id])
  files       PrintFile[]

  @@index([shopId, status])
  @@index([customerToken])
  // UNIQUE constraint on (shopId, tokenNumber) — at most one order per shop
  // can hold any given non-null tokenNumber. NULL tokenNumbers (legacy orders
  // that predate token allocation, or orders that exhausted the retry loop)
  // are permitted in any quantity — both SQLite and PostgreSQL treat NULLs
  // as distinct in a UNIQUE constraint, so the index does NOT block them.
  // This is the authoritative race-safe guard: a concurrent double-INSERT
  // with the same candidate token fails here (Prisma P2002 / PG 23505),
  // which the order-creation route catches and retries with a new candidate.
  @@unique([shopId, tokenNumber])
}

model PrintFile {
  id               String    @id @default(uuid())
  orderId          String
  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  pageCount        Int?
  copies           Int       @default(1)
  colorMode        String    @default("bw")
  pageRange        String?
  paperSize        String    @default("a4")
  duplex           Boolean   @default(false)
  pricePaise       Int       @default(0)
  status           String    @default("pending")
  printedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order     Order     @relation(fields: [orderId], references: [id])
  printJobs PrintJob[]

  @@index([orderId])
}

model PrintJob {
  id          String    @id @default(uuid())
  shopId      String
  fileId      String
  agentId     String?
  status      String    @default("queued")
  attempts    Int       @default(0)
  lastError   String?
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shop  Shop  @relation(fields: [shopId], references: [id])
  file  PrintFile @relation(fields: [fileId], references: [id])

  @@index([shopId, status])
  @@index([agentId])
}

model PrintAgent {
  id         String    @id @default(uuid())
  shopId     String
  name       String
  tokenHash  String
  lastSeenAt DateTime?
  printerName String?
  isOnline   Boolean   @default(false)
  version    String?
  os         String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId, isOnline])
}

model Subscription {
  id                     String   @id @default(uuid())
  shopId                 String   @unique
  tier                   String   @default("free")
  status                 String   @default("active")
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  provider               String   @default("internal")
  providerSubscriptionId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  shopId     String?
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   String // JSONB-equivalent
  ip         String?
  createdAt  DateTime @default(now())

  shop Shop?  @relation(fields: [shopId], references: [id])
  user User?  @relation(fields: [userId], references: [id])

  @@index([shopId, createdAt])
}
