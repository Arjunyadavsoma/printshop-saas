generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id                    String           @id @default(uuid())
  name                  String
  slug                  String           @unique
  ownerUserId           String
  upiId                 String
  paymentProvider       String
  paymentCredentials    String
  pricingConfig         String
  address               String
  phone                 String
  timezone              String           @default("Asia/Kolkata")
  isActive              Boolean          @default(true)
  subscriptionTier      String           @default("free")
  subscriptionExpiresAt DateTime?
  description           String?
  businessHours         String?
  logoUrl               String?
  upiQrStorageKey       String?
  servicesJson          String?
  paymentPhone          String?
  paymentInstructions   String?
  cashOnPickup          Boolean          @default(false)
  // ── Payment method customization ──
  // 'upi' = UPI only, 'cash' = cash only, 'both' = UPI + cash,
  // 'split' = split payment (partial UPI + partial cash)
  paymentMethods        String           @default("both")
  // ── Pamphlet / cover sheet feature ──
  // Shopkeeper can offer a pamphlet (folder/cover) where printed pages are
  // kept. Customer can add it during checkout (extra charge). Useful when
  // customer prints from home + picks up later.
  pamphletEnabled       Boolean          @default(false)
  pamphletPricePaise    Int              @default(0)
  pamphletName          String?
  // ── Product build Phase 1: operations + billing mode (additive) ──
  upiPayeeName          String?
  isOpen                Boolean          @default(true)
  acceptingOrders       Boolean          @default(true)
  openingHours          Json?
  // ── Location-aware discovery (additive, nullable) ──
  // Coordinates are set by the shopkeeper (settings) or geocoded from the
  // address/pincode; null until then. No PostGIS — nearby search does a
  // bounding-box prefilter + Haversine in JS (see /api/shops/nearby).
  latitude              Float?
  longitude             Float?
  fullAddress           String?
  city                  String?
  state                 String?
  pincode               String?
  locationVerified      Boolean          @default(false)
  locationUpdatedAt     DateTime?
  languages             Json             @default("[\"en\"]")
  retentionHours        Int              @default(24)
  // UPI_THEN_PRINT | PRINT_THEN_PAY | BOTH (legacy paymentMethods untouched)
  paymentMode           String           @default("UPI_THEN_PRINT")
  autoConfirmCounterPayment Boolean      @default(false)
  // PER_PAGE_ACTUAL | SHEET_AS_COLOR
  colorSheetBilling     String           @default("PER_PAGE_ACTUAL")
  orderExpiryMinutes    Int              @default(30)
  urgencySurchargePaise Int              @default(0)
  scheduledOrders       Boolean          @default(false)
  minutesPerPageBw      Int              @default(1)
  minutesPerPageColor   Int              @default(2)
  printers              Printer[]
  priceRules            PriceRule[]
  addons                Addon[]
  notifications         Notification[]
  // NOTE: revision + deletedAt removed from existing models to avoid
  // breaking production (DB migration not yet run). See docs/MIGRATION_PLAN.md.
  // These will be re-added when `bun run db:push` is executed.
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  auditLogs             AuditLog[]
  orders                Order[]
  agents                PrintAgent[]
  printJobs             PrintJob[]
  pairingTickets        PairingTicket[]
  deviceCommands        DeviceCommand[]
  subscription          Subscription?
  users                 User[]
  paymentAttempts       PaymentAttempt[]

  @@index([slug])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String
  passwordHash String
  role         String     @default("owner") // owner | operator
  name         String?
  lastLoginAt  DateTime?
  shopId       String?
  clerkId      String?    @unique // Clerk user id (user_…) when linked to Clerk sign-in; null for password-only accounts
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  shop         Shop?      @relation(fields: [shopId], references: [id])
  passwordResetTokens PasswordResetToken[]

  @@index([shopId])
}

// ─── Customer accounts (consumer Google sign-in) ────────────────────────
// A customer account is a SEPARATE table from `User` on purpose — never
// a `User` row with role `customer`:
//
//   - `User.email` and `User.clerkId` are both @unique, and `User.role`
//     is a single string. One Clerk id / one email maps to exactly one
//     User row, so the same Google account could never be both a
//     shopkeeper (owner) and a customer in that table — and the customer
//     sign-in flow must never link a Clerk id onto an owner row (that
//     would hand the customer flow an owner JWT).
//   - With its own table, the same Google account (same email, same
//     Clerk id) can hold a shopkeeper account AND a customer account
//     independently. The customer exchange route
//     (`/api/v1/auth/clerk-session/customer`) only ever reads/writes
//     this table — see `src/lib/auth/clerk-customers.ts`.
//
// Named `CustomerAccount` (not `Customer`) because the schema already
// has a shop-scoped `Customer` model — the per-shop customer directory
// a shopkeeper sees under /shop/customers. That model is unrelated to
// sign-in; this one is the consumer's Google account.
//
// Customers have no password and no shop: Google sign-in IS the signup
// (Clerk SSO creates the row on first sign-in, exactly like the
// shopkeeper flow). `name`/`phone` are filled from the Clerk profile
// when available and editable via PATCH /api/v1/customer/me — the
// checkout form prefills them. Guest ordering is untouched: an order
// only gains a `customerId` when it is placed while signed in.
model CustomerAccount {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  phone     String?
  clerkId   String?  @unique // Clerk user id (user_…) when linked to Clerk sign-in
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([clerkId])
}

// ─── Password reset tokens (H16) ───────────────────────────────────────
// Single-use, short-lived tokens for the "forgot password" flow. We store
// ONLY the SHA-256 hash of the token — never the plaintext. The plaintext
// token is sent to the user via email (or captured to memory by the
// StubEmailAdapter in dev) and is never persisted anywhere.
//
// Lifecycle:
//   1. POST /api/v1/auth/forgot-password → generate token, store hash,
//      expiry=15min, send email with `?token=<plaintext>` link.
//   2. POST /api/v1/auth/reset-password → hash the submitted token, look
//      up by hash, check expiry + not-yet-used, update the user's
//      passwordHash, mark `usedAt`, revoke all refresh tokens (TODO — needs
//      a RefreshToken table to enumerate jtis per user; for now the old
//      tokens remain live until their TTL expires).
//   3. Token is single-use: `usedAt` is checked on every reset attempt.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  // SHA-256 hash of the plaintext reset token (never store the plaintext).
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Order {
  id               String           @id @default(uuid())
  shopId           String
  customerToken    String
  status           String           @default("awaiting_payment")
  totalAmountPaise Int
  currency         String           @default("INR")
  paymentProvider  String?
  paymentTxnId     String?          @unique
  paymentUtr       String?
  paidAt           DateTime?
  customerName     String?
  customerPhone    String?
  // Link to the signed-in customer account that placed this order, when
  // there is one. NULL for guest orders (the default). Set only by
  // `placeOrder` when the place-order request carries a valid customer
  // JWT — never trusted from the request body. Drives the signed-in
  // order history at GET /api/v1/customer/orders.
  customerId       String?
  customerAccount  CustomerAccount? @relation(fields: [customerId], references: [id])
  notes            String?
  // ── Product build Phase 1: pickup + pricing snapshot (additive) ──
  orderNumber      String?
  pickupCode       String?
  subtotalPaise    Int              @default(0)
  addonsPaise      Int              @default(0)
  priceSnapshot    Json?
  placedAt         DateTime?
  readyAt          DateTime?
  collectedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  urgent           Boolean          @default(false)
  expiresAt        DateTime?
  paymentModeAtOrder String?
  scheduledFor     DateTime?
  tokenNumber      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  shop             Shop             @relation(fields: [shopId], references: [id])
  files            PrintFile[]
  paymentAttempts  PaymentAttempt[]
  payments         Payment[]
  events           OrderEvent[]
  notifications    Notification[]
  refunds          Refund[]

  @@unique([shopId, tokenNumber])
  @@index([customerId])
  // H9 fix: customerToken is the per-order "credential" customers use to
  // access their own order status / receipt / file downloads. Without a
  // UNIQUE constraint on (shopId, customerToken), two orders in the same
  // shop could be issued the same 6-char token — a collision that would
  // silently let one customer see another's order via withOrderAccess
  // (which constant-time-compares the token and grants access on match).
  // The token generator uses random 6-char strings so collisions are rare,
  // but the DB constraint is the backstop that guarantees correctness.
  @@unique([shopId, customerToken])
  @@index([shopId, status])
  @@index([customerToken])
}

model PrintFile {
  id               String     @id @default(uuid())
  orderId          String
  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  pageCount        Int?
  pageCountSource  String     @default("placeholder")
  copies           Int        @default(1)
  colorMode        String     @default("bw")
  pageRange        String?
  paperSize        String     @default("a4")
  duplex           Boolean    @default(false)
  pricePaise       Int        @default(0)
  status           String     @default("pending")
  processingError  String?
  // Phase 4 (B-010): SHA-256 hex of the stored file bytes, computed server-side
  // at confirm time when the storage adapter exposes getBytes. Delivered to the
  // companion in the agent pending-jobs payload (pdfSha256) so it can verify the
  // downloaded bytes BEFORE printing; also verified against the agent's receipt
  // checksum (trust-on-first-use if null — see the received-report route).
  // ── Product build Phase 2: normalized PDF + geometry + suggestion ──
  pdfStorageKey    String?
  pageWidthPt      Float?
  pageHeightPt     Float?
  failReason       String?
  checksum         String?
  colorSuggestion  Json?
  spec             PrintSpec?
  sha256           String?
  printedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  order            Order      @relation(fields: [orderId], references: [id])
  printJobs        PrintJob[]

  @@index([orderId])
}

model PrintJob {
  id          String    @id @default(uuid())
  shopId      String
  fileId      String
  agentId     String?
  // ── Product build Phase 1: PrintTask columns (additive; device contract
  // routes keep their shape — older companions ignore unknown fields) ──
  printerId   String?
  // color_set | bw_set | full
  kind        String?
  // int[] — original page numbers inside this task, in order
  sourcePages Json?
  taskPdfStorageKey String?
  sheetCount  Int?
  copies      Int?
  colorMode   String?
  paperSize   String?
  duplex      Boolean?
  pagesPerSheet Int     @default(1)
  orientation String?
  scale       String?
  setLabel    String?
  idempotencyKey String @unique
  dispatchedAt DateTime?
  printedAt   DateTime?
  status      String    @default("queued")
  attempts    Int       @default(0)
  lastError   String?
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  file        PrintFile @relation(fields: [fileId], references: [id])
  shop        Shop      @relation(fields: [shopId], references: [id])
  printer     Printer?  @relation(fields: [printerId], references: [id])
  // ── Mobile executor / queue v2 (additive; old agents ignore these) ──
  priority            Int       @default(0)   // 0 normal, 10 urgent
  position            String    @default("a0") // fractional index for drag reorder
  isHeld              Boolean   @default(false)
  executorMode        String    @default("AUTO") // AUTO | MANUAL_ONLY
  claimedByAgentId    String?
  claimLeaseExpiresAt DateTime?
  version             Int       @default(1)   // optimistic concurrency
  lastExecutorKind    String?                  // PC | MOBILE

  @@index([shopId, status])
  @@index([agentId])
  @@index([printerId])
  @@index([shopId, isHeld, priority, position])
  @@index([claimedByAgentId])
}

model PrintAgent {
  id              String    @id @default(uuid())
  shopId          String
  name            String
  tokenHash       String
  // Token rotation: hash of the credential that was valid immediately
  // before the current one, plus when the rotation happened. The previous
  // token is honoured for a short grace window (10 minutes) so an in-flight
  // request is not dropped mid-rotation, then stops working.
  prevTokenHash   String?
  tokenRotatedAt  DateTime?
  lastSeenAt      DateTime?
  printerName     String?
  isOnline        Boolean   @default(false)
  version         String?
  os              String?
  isEnabled       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  shop            Shop      @relation(fields: [shopId], references: [id])
  pairingTickets  PairingTicket[]
  deviceCommands  DeviceCommand[]
  // ── Mobile executor (additive) ──
  kind            String    @default("PC")  // PC | MOBILE
  platform        String?                   // android | ios | windows | linux
  appVersion      String?
  capabilities    String    @default("[]") // JSON array: ["queue.v2","ipp.lan"]
  agentName       String?                   // human-readable: "Ana's phone"
  printerPaths    PrinterPath[]

  @@index([shopId, isOnline])
  @@index([shopId, isEnabled])
  @@index([shopId, kind])
}

/// Single-use, short-lived pairing ticket for the PrintEXE companion.
/// Created by an authenticated shopkeeper, consumed once by the companion
/// to exchange for a device token. Only the SHA-256 hash is stored.
model PairingTicket {
  id              String    @id @default(uuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id])
  agentId         String?
  agent           PrintAgent? @relation(fields: [agentId], references: [id])
  createdByUserId String
  ticketHash      String    @unique
  status          String    @default("active") // active|consumed|expired|revoked
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
  deviceName      String?
  deviceMetadata  String?

  @@index([shopId, status])
  @@index([expiresAt])
}

/// Remote command sent from the website to a PrintEXE companion device.
/// Commands are persisted before delivery, validated against an allowlist,
/// and tracked through their full lifecycle.
model DeviceCommand {
  id              String    @id @default(uuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id])
  agentId         String
  agent           PrintAgent @relation(fields: [agentId], references: [id])
  commandType     String    // refresh_printers|pause|resume|cancel_job|retry_job|test_print|diagnostics
  payload         String    // JSON string — validated per command type
  status          String    @default("requested") // requested|delivered|accepted|executing|succeeded|failed|outcome_unknown|expired|cancelled
  initiatedBy     String    // user ID who sent the command
  result          String?   // JSON string with execution result/error
  idempotencyKey  String    @unique
  expiresAt       DateTime
  deliveredAt     DateTime?
  executedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([shopId, agentId, status])
  @@index([agentId, status])
}

model Subscription {
  id                     String   @id @default(uuid())
  shopId                 String   @unique
  tier                   String   @default("free")
  status                 String   @default("active")
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  provider               String   @default("internal")
  providerSubscriptionId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  shop                   Shop     @relation(fields: [shopId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  shopId     String?
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   String
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  shop       Shop?    @relation(fields: [shopId], references: [id])

  @@index([shopId, createdAt])
}

// ─── Payment persistence (Phase 4 — durable webhook mapping) ───────
// Previously the merchantOrderId→orderId mapping lived ONLY in a 10-min
// cache session. Slow PSPs (>10min) or Vercel cold starts (per-invocation
// memory) made delayed webhooks impossible to resolve. These models move
// the mapping into durable DB records.

model PaymentAttempt {
  id                    String         @id @default(uuid())
  shopId                String
  orderId               String
  provider              String // 'phonepe' | 'paytm' | 'googlepay' (UPI deep-link)
  merchantOrderId       String         @unique // our per-attempt UUID; the PSP references this
  providerTransactionId String? // PSP's transaction id (set on webhook/status)
  amountPaise           Int
  currency              String         @default("INR")
  status                String         @default("created") // created|pending|paid|failed|expired
  idempotencyKey        String? // optional PSP idempotency token
  expiresAt             DateTime
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  shop                  Shop           @relation(fields: [shopId], references: [id])
  order                 Order          @relation(fields: [orderId], references: [id])
  events                PaymentEvent[]

  @@index([shopId, status])
  @@index([orderId])
  @@index([orderId, status])
  @@index([providerTransactionId])

  // Phase 6.4: Partial unique index — at most one 'created' attempt per order.
  // Prisma 6.x does NOT natively support partial unique indexes in the schema
  // declaration (@@unique creates a full UNIQUE constraint, not partial). The
  // authoritative DDL lives in
  // `prisma/migrations/20251110000000_add_active_attempt_unique_index/migration.sql`
  // and is applied by `prisma migrate deploy` / `pg-migrate-prod.sh`.
  // The comment here is documentation only — `prisma validate` does not
  // verify partial indexes (they are PostgreSQL-specific extensions beyond
  // Prisma's declarative schema grammar).
}

model PaymentEvent {
  id                    String         @id @default(uuid())
  attemptId             String
  provider              String
  eventId               String? // PSP's event id (for dedup)
  merchantOrderId       String?
  providerTransactionId String?
  eventType             String // webhook|status_check|reconciliation
  signatureValid        Boolean        @default(false)
  processingStatus      String         @default("received") // received|processed|skipped|failed
  receivedAt            DateTime       @default(now())
  processedAt           DateTime?
  errorMessage          String?
  attempt               PaymentAttempt @relation(fields: [attemptId], references: [id])

  @@unique([provider, eventId])
  @@index([attemptId])
  @@index([merchantOrderId])
}

// ─── Webhook Inbox (Phase 6.12) ──────────────────────────────────────
// Durable storage for verified webhook callbacks that arrive before the
// corresponding PaymentAttempt exists (race condition: callback beats
// checkout persistence). The recovery worker (invoked by the reconciliation
// cron) matches inbox entries to PaymentAttempts and processes them.
//
// Only VERIFIED callbacks (signature passed) are persisted here.
// Unverified callbacks are rejected with 401 and NOT persisted.
//
// No secrets, authorization headers, or raw payload bytes are stored.

model WebhookInbox {
  id                   String    @id @default(uuid())
  provider             String   // phonepe | paytm | googlepay
  merchantOrderId      String   // the reference extracted from the payload
  providerEventId      String?  // PSP's event ID (for dedup, if available)
  providerTxnId        String?  // PSP's transaction ID
  amountPaise          Int?     // amount from the verified payload
  currency             String   @default("INR")
  signatureValid       Boolean  @default(true) // always true — only verified events are stored
  processingStatus     String   @default("unmatched") // unmatched|matched|processed|exhausted
  receivedAt           DateTime @default(now())
  processedAt          DateTime?
  retryCount           Int      @default(0)
  nextRetryAt          DateTime?
  errorMessage         String?

  @@unique([provider, providerEventId])
  @@index([merchantOrderId])
  @@index([processingStatus, nextRetryAt])
}

// ─── Sync infrastructure (Phase 5) ───────────────────────────────────
// Bidirectional sync state for the PrintEXE Windows desktop client.
// See docs/SYNC_PROTOCOL.md for the full design.

model DeviceSyncState {
  id         String    @id @default(uuid())
  shopId     String // tenant FK
  deviceId   String // the PrintAgent ID acting as a sync device
  syncCursor String    @default("1970-01-01T00:00:00Z") // ISO timestamp cursor
  lastSyncAt DateTime?
  lastPushAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([shopId, deviceId])
  @@index([shopId])
}

model Customer {
  id        String    @id @default(uuid())
  shopId    String // tenant FK
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  // Sync fields
  revision  Int       @default(1)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

// ─── Delivery infrastructure (Phase 5-7) ─────────────────────────────
// Tracks each attempt to deliver a print job to a PrintEXE device.
// Separate from PrintJob.status (printing state) — this tracks the
// DOCUMENT DELIVERY state (was the file received by the device?).
// See docs/DOCUMENT_DELIVERY_ARCHITECTURE.md

model PrintDeliveryAttempt {
  id           String    @id @default(uuid())
  printJobId   String // FK → PrintJob (logical — no Prisma relation to avoid migration)
  agentId      String // FK → PrintAgent (the targeted device)
  shopId       String // tenant FK
  attemptId    Int       @default(1) // per-job sequence (1st attempt, 2nd, etc.)
  deliveryMode String    @default("cloud") // cloud|direct|webrtc
  status       String    @default("created") // created|dispatched|received|failed|expired
  checksum     String? // SHA-256 hex of the delivered file
  fileSize     Int? // bytes
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shopId, status])
  @@index([agentId])
  @@index([printJobId])
}

// Scheduled cloud file cleanup tasks.
// Created after a delivery receipt is confirmed — the file is deleted
// from cloud storage after a grace period (default 15 min).
// See docs/FILE_RETENTION_POLICY.md

model FileCleanupTask {
  id          String    @id @default(uuid())
  printFileId String // FK → PrintFile (logical)
  shopId      String // tenant FK
  storageKey  String // the S3/R2/Supabase object key
  cleanupType String    @default("after_receipt") // after_receipt|after_collect|forced
  scheduledAt DateTime // when to attempt deletion
  completedAt DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  status      String    @default("pending") // pending|completed|failed|skipped
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([shopId, status])
  @@index([scheduledAt])
  @@index([printFileId])
}

// ─── Product build Phase 1: printers, specs, pricing, direct payments ───

model Printer {
  id             String    @id @default(uuid())
  shopId         String
  agentId        String?
  systemName     String // Windows queue name the agent prints through
  displayName    String
  supportsColor  Boolean   @default(false)
  supportsDuplex Boolean   @default(false)
  paperSizes     Json      @default("[\"A4\"]")
  isDefaultColor Boolean   @default(false)
  isDefaultBw    Boolean   @default(false)
  status         String    @default("OFFLINE") // ONLINE | OFFLINE | PAUSED | ERROR
  statusDetail   String?
  speedPpm       Int       @default(20)
  pagesPrintedToday Int    @default(0)
  counterDate    DateTime?
  lastSeenAt     DateTime?
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  shop           Shop      @relation(fields: [shopId], references: [id])
  jobs           PrintJob[]
  paths          PrinterPath[]
  printerUuid    String?   // IPP printer-uuid or mDNS UUID for merging

  @@unique([shopId, systemName])
  @@index([shopId, enabled])
  @@index([printerUuid])
}

/// PrinterPath — one physical printer accessible via multiple routes.
/// A Windows queue (PC agent) and a LAN IPP URI (phone) can be paths
/// on the same logical Printer (merged by printerUuid).
model PrinterPath {
  id           String   @id @default(uuid())
  printerId    String
  agentId      String
  kind         String   // WINDOWS_QUEUE | LAN_IPP | RAW9100
  uri          String   // ipp://192.168.1.50:631/ipp/print | windows:HP_LaserJet
  lastSeenAt   DateTime?
  status       String   @default("unknown") // online|offline|error|unknown
  capabilities String   @default("{}")      // JSON: document-format-supported, sides, etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  printer      Printer    @relation(fields: [printerId], references: [id])
  agent        PrintAgent @relation(fields: [agentId], references: [id])

  @@unique([printerId, agentId, kind])
  @@index([printerId])
  @@index([agentId])
}

model PrintSpec {
  id            String   @id @default(uuid())
  orderFileId   String   @unique
  copies        Int      @default(1)
  paperSize     String   @default("A4")
  paperType     String   @default("PLAIN")
  orientation   String   @default("AUTO")
  sides         String   @default("SINGLE")
  duplexEdge    String   @default("long")
  pagesPerSheet Int      @default(1)
  scale         String   @default("FIT")
  collate       Boolean  @default(true)
  pageRangeText String?
  // source of truth for per-page modes: [{page, mode: "color"|"bw"|"skip"}]
  pageModes     Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orderFile     PrintFile @relation(fields: [orderFileId], references: [id])
}

model PriceRule {
  id            String   @id @default(uuid())
  shopId        String
  paperSize     String
  paperType     String   @default("PLAIN")
  colorMode     String // BW | COLOR
  sides         String   @default("SINGLE")
  slabs         Json // [{minPages, perPagePaise}]
  active        Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shop          Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, active])
}

model Addon {
  id          String  @id @default(uuid())
  shopId      String
  kind        String // staple | spiral_bind | laminate | urgent | home_delivery_note
  label       String
  pricePaise  Int
  pricingUnit String  @default("PER_ORDER") // PER_ORDER | PER_COPY | PER_SHEET
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, active])
}

// Direct-UPI + counter payment flow (PaymentAttempt/PaymentEvent stay for
// the PhonePe gateway flow — two different mechanisms, both kept).
model Payment {
  id                  String    @id @default(uuid())
  orderId             String
  method              String // upi | counter_cash | counter_upi
  status              String    @default("PENDING") // PENDING | SUBMITTED | CONFIRMED | REJECTED | REFUNDED_NOTE
  amountPaise         Int
  upiIntentUrl        String?
  utr                 String?
  screenshotStorageKey String?
  confirmedBy         String?
  confirmedAt         DateTime?
  rejectReason        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  order               Order     @relation(fields: [orderId], references: [id])

  @@index([orderId, status])
}

// Structured refund tracking. Reuses the existing provider adapters'
// refund() methods (Razorpay/PhonePe/Paytm all implement it). One refund
// per (provider, providerRefundId) — the DB backstop against duplicate
// refund initiation. The amount is integer paise; `status` is a plain
// string (pending|succeeded|failed) enforced by the payment state machine
// in src/lib/payments/payment-state-machine.ts, not a Prisma enum (the
// schema has zero enums by convention).
model Refund {
  id                 String    @id @default(uuid())
  orderId            String
  paymentId          String?   // FK to Payment (direct-UPI/counter flow)
  paymentAttemptId   String?   // FK to PaymentAttempt (gateway flow)
  provider           String    // razorpay | phonepe | paytm | googlepay | manual
  providerRefundId   String?   // PSP's refund reference (null until PSP confirms)
  amountPaise        Int       // always > 0, always <= order.totalAmountPaise
  reason             String    @default("Customer request")
  status             String    @default("pending") // pending | succeeded | failed
  initiatedBy        String    // userId of the shopkeeper/admin
  initiatedAt        DateTime  @default(now())
  completedAt        DateTime?
  errorMessage       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  order              Order     @relation(fields: [orderId], references: [id])

  // One refund per PSP reference — the replay guard.
  @@unique([provider, providerRefundId])
  @@index([orderId])
  @@index([status])
}

// Append-only timeline powering the tracking UI and the dispute log.
model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  type      String
  actorType String // customer | shop | system | agent
  actorId   String?
  data      Json?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

// In-app notifications for the shopkeeper (MessageChannel adapters add
// WhatsApp/SMS later; console impl in dev).
model Notification {
  id        String    @id @default(uuid())
  shopId    String
  kind      String // new_order | payment_submitted | task_failed | low_supplies | ...
  orderId   String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shop      Shop      @relation(fields: [shopId], references: [id])
  order     Order?    @relation(fields: [orderId], references: [id])

  @@index([shopId, readAt, createdAt])
}

// ── Resumable upload sessions (P8.7, DB-backed) ──────────────────────────
// Sessions were previously held in a per-process in-memory Map + /tmp chunk
// files. On Vercel every lambda instance has its own Map, so init/chunk/
// complete hitting different instances returned "Upload session not found"
// and the customer saw "Failed to process — tap to retry". Storing sessions
// + chunks in Postgres makes every instance share the same state.

model UploadSession {
  uploadId     String   @id
  orderId      String
  fileId       String
  orderToken   String
  shopId       String
  filename     String
  mimeType     String
  declaredSize Int
  chunkSize    Int
  status       String   @default("active") // active | expired | completed
  createdAt    DateTime @default(now())
  lastChunkAt  DateTime @default(now())
  chunks       UploadChunk[]

  @@index([lastChunkAt])
  @@index([createdAt])
}

model UploadChunk {
  id        String        @id @default(uuid())
  uploadId  String
  idx       Int
  checksum  String
  size      Int
  bytes     Bytes
  createdAt DateTime      @default(now())
  session   UploadSession @relation(fields: [uploadId], references: [uploadId], onDelete: Cascade)

  @@unique([uploadId, idx])
  @@index([uploadId])
}
